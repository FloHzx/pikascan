{
  "manifest_version": 3,
  "name": "PikaScan – Envoyer l'annonce",
  "version": "1.3.3",
  "description": "Sur une annonce Vinted, un clic envoie le titre, le prix et les photos à PikaScan ; PikaScan peut aussi lire les prix des ventes eBay terminées.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.vinted.fr/*",
    "https://*.vinted.com/*",
    "https://*.vinted.net/*",
    "https://*.vinted.be/*",
    "https://*.vinted.es/*",
    "https://*.vinted.it/*",
    "https://*.vinted.de/*",
    "https://*.vinted.nl/*",
    "https://*.vinted.pl/*",
    "https://*.vinted.pt/*",
    "https://*.vinted.lt/*",
    "https://*.vinted.cz/*",
    "https://*.vinted.at/*",
    "https://*.vinted.lu/*",
    "https://*.vinted.co.uk/*",
    "https://flohzx.github.io/*",
    "https://www.ebay.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Envoyer cette annonce à PikaScan",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flohzx.github.io/pikascan/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}